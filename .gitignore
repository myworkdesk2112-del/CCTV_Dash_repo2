# Secrets — never commit the sandbox access password/session cookie
.env
!.env.example

# Python
__pycache__/
*.pyc
.venv/
*.db
# SQLite write-ahead log / shared-memory / rollback journal: these hold
# uncheckpointed rows from the live pilot DB (events, key hashes, sessions)
*.db-wal
*.db-shm
*.db-journal

# ML model weights — large, auto-downloaded, don't belong in git
*.pt
*.onnx
.paddleocr/

# Evidence crops — generated at runtime from live/sandbox footage, not
# source, not a deliverable to commit (see config.CROPS_DIR).
sentinel-solution/backend/data/crops/

# Real ANPR scan output — real sandbox camera images (scripts/real_anpr_scan.py),
# not source, not a deliverable; findings are written up in HLD.md/REQUIREMENTS_COVERAGE.md instead.
sentinel-solution/backend/data/anpr_scan/

# Node
node_modules/
dist/
dist-ssr/

# Deck-building tool venv + rendered preview PNGs — not deliverables,
# regenerate via deck-build/build_deck.py. The .pptx itself IS a deliverable
# and is intentionally NOT ignored.
deck-build/.venv/
deck-build/preview*/

# Demo recording output — stock footage clips + browser screen recordings
# used while producing the submission video, not source, not a deliverable
# (the deliverable is the final rendered video itself, tracked elsewhere).
sentinel-solution/demo_output/

# Editor/OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Microsoft Office lock files (transient, created while a .pptx/.docx is open)
~$*

# Generated deck slide previews — regenerate with deck-build/build_deck_v2.py
sentinel-solution/deck-build/preview_final/
